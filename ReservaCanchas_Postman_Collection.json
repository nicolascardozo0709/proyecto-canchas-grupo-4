    {
      "name": "2. Escenarios Deportivos (Catálogo & CRUD)",
      "item": [
        {
          "name": "2.1 Listar Todos los Escenarios (Público)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var data = pm.response.json();",
                  "pm.test(\"Catálogo contiene escenarios\", function () {",
                  "    pm.expect(data.length).to.be.at.least(1);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/escenarios",
              "host": ["{{baseUrl}}"],
              "path": ["api", "escenarios"]
            }
          }
        },
        {
          "name": "2.2 Consultar Escenario por ID (1)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/escenarios/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "escenarios", "1"]
            }
          }
        },
        {
          "name": "2.3 Activar Estado de Mantenimiento (Admin HU-21)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/escenarios/1/mantenimiento?enMantenimiento=true",
              "host": ["{{baseUrl}}"],
              "path": ["api", "escenarios", "1", "mantenimiento"],
              "query": [
                {
                  "key": "enMantenimiento",
                  "value": "true"
                }
              ]
            }
          }
        },
        {
          "name": "2.4 Desactivar Mantenimiento (Admin HU-21)",
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/escenarios/1/mantenimiento?enMantenimiento=false",
              "host": ["{{baseUrl}}"],
              "path": ["api", "escenarios", "1", "mantenimiento"],
              "query": [
                {
                  "key": "enMantenimiento",
                  "value": "false"
                }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "3. Franjas Horarias (60 min)",
      "item": [
        {
          "name": "3.1 Consultar Franjas Horarias del Escenario 1",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var franjas = pm.response.json();",
                  "pm.test(\"Franjas activas de 60 min\", function () {",
                  "    pm.expect(franjas.length).to.be.at.least(5);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/franjas/escenario/1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "franjas", "escenario", "1"]
            }
          }
        }
      ]
    },
    {
      "name": "4. Reservas Transaccionales (HU-05, HU-06, HU-07, HU-08)",
      "item": [
        {
          "name": "4.1 Consultar Matriz de Disponibilidad (WF-02)",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/reservas/disponibilidad?escenarioId=1&fecha=2026-10-25",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservas", "disponibilidad"],
              "query": [
                {
                  "key": "escenarioId",
                  "value": "1"
                },
                {
                  "key": "fecha",
                  "value": "2026-10-25"
                }
              ]
            }
          }
        },
        {
          "name": "4.2 Crear Reserva Exitosa (Nicolás - Franja 3)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 201 CREATED\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});",
                  "var res = pm.response.json();",
                  "pm.test(\"Código de reserva generado\", function () {",
                  "    pm.expect(res.codigoReserva).to.include(\"RES-\");",
                  "    pm.expect(res.estado).to.eql(\"CONFIRMADA\");",
                  "});",
                  "pm.collectionVariables.set(\"reserva_id\", res.id.toString());"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_user}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"escenarioId\": 1,\n  \"franjaId\": 3,\n  \"fecha\": \"2026-10-25\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservas"]
            }
          }
        },
        {
          "name": "4.3 Intento de Doble Reserva (Colisión / Overbooking - 409 Conflict)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Control Anti-Colisión bloquea con 409 CONFLICT\", function () {",
                  "    pm.response.to.have.status(409);",
                  "});",
                  "var errorJson = pm.response.json();",
                  "pm.test(\"Error RFC 7807 es CONFLICTO_COLISION_HORARIO\", function () {",
                  "    pm.expect(errorJson.error).to.eql(\"CONFLICTO_COLISION_HORARIO\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_user}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"escenarioId\": 1,\n  \"franjaId\": 3,\n  \"fecha\": \"2026-10-25\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservas"]
            }
          }
        },
        {
          "name": "4.4 Intento de Reserva en Fecha Pasada (400 Bad Request HU-08)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Bloqueo de fecha pasada retorna 400 Bad Request\", function () {",
                  "    pm.response.to.have.status(400);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_user}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"escenarioId\": 1,\n  \"franjaId\": 3,\n  \"fecha\": \"2020-01-01\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservas"]
            }
          }
        },
        {
          "name": "4.5 Consultar Mis Reservas (Usuario Autenticado WF-03)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var list = pm.response.json();",
                  "pm.test(\"Retorna lista de reservas\", function () {",
                  "    pm.expect(list).to.be.an('array');",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_user}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservas/mis-reservas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservas", "mis-reservas"]
            }
          }
        },
        {
          "name": "4.6 Cancelar Reserva y Liberar Franja (HU-06)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Cancelación exitosa con 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var c = pm.response.json();",
                  "pm.test(\"Estado cambiado a CANCELADA\", function () {",
                  "    pm.expect(c.estado).to.eql(\"CANCELADA\");",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "PUT",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_user}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"motivo\": \"Cancelación voluntaria desde Postman\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservas/{{reserva_id}}/cancelar",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservas", "{{reserva_id}}", "cancelar"]
            }
          }
        },
        {
          "name": "4.7 Re-reserva Inmediata de Franja Liberada",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Franja liberada se puede reservar nuevamente con 201\", function () {",
                  "    pm.response.to.have.status(201);",
                  "});"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_user}}"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"escenarioId\": 1,\n  \"franjaId\": 3,\n  \"fecha\": \"2026-10-25\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservas"]
            }
          }
        },
        {
          "name": "4.8 Listar Todas las Reservas (Solo Admin)",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Authorization",
                "value": "Bearer {{token_admin}}"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/reservas",
              "host": ["{{baseUrl}}"],
              "path": ["api", "reservas"]
            }
          }
        }
      ]
    }
