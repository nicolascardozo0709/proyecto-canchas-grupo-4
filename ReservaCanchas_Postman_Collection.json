  "item": [
    {
      "name": "1. Autenticación (JWT & BCrypt Cost 12)",
      "item": [
        {
          "name": "1.1 Login Administrador (admin@canchas.com)",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"Status code is 200 OK\", function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "var jsonData = pm.response.json();",
                  "pm.test(\"Token JWT recibido y rol ROLE_ADMIN\", function () {",
                  "    pm.expect(jsonData.token).to.be.a('string');",
                  "    pm.expect(jsonData.rol).to.eql('ROLE_ADMIN');",
                  "});",
                  "pm.collectionVariables.set(\"token_admin\", jsonData.token);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@canchas.com\",\n  \"password\": \"admin123\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["api", "auth", "login"]
            }
          }
        },
